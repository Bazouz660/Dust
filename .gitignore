# Build outputs
build/
*/build/
**/build/
*.obj
*.o
*.pdb
*.iobj
*.ipdb
*.exp
*.lib
*.dll
*.exe
*.ilk
*.log
*.tlog/
*.lastbuildstate
*.recipe

# Visual Studio
.vs/
*.vcxproj.user
*.suo
*.sdf
*.opensdf
*.ncb
*.opendb
*.VC.db
*.VC.opendb
Debug/
Release/
x64/
