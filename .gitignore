# RenderDoc captures
captures/*.rdc
captures/*.xml

# Python
__pycache__/
*.py[cod]
*.pyo

# Local dev / analysis scripts (never shipped; one previously held an API key).
# Force-add a specific script with `git add -f tools/<file>` if you want it tracked.
tools/

# Stray per-preset effect dumps left by deploy round-trips (not real preset data)
effects/presets/*/effects/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Environment
.env

# Claude Code
.claude/settings.local.json
.openclaude-profile.json

# External dependencies (non-submodule)
external/*
!external/KenshiLib
!external/KenshiLib_Examples_deps
