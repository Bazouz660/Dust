  <!-- DLSS/NGX: only wired in when the SDK is present (external/DLSS is gitignored). When absent,
       DUST_HAVE_DLSS stays undefined so Upscaler.cpp compiles to stubs and the repo still builds.
       Fetch the SDK with a shallow git clone of github.com/NVIDIA/DLSS into external/DLSS. -->
  <PropertyGroup>
    <HaveDlss Condition="Exists('$(ProjectDir)..\external\DLSS\include\nvsdk_ngx.h')">true</HaveDlss>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(HaveDlss)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>DUST_HAVE_DLSS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\external\DLSS\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\external\DLSS\lib\Windows_x86_64\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(HaveDlss)'=='true' And '$(Configuration)'=='Release'">
    <Link>
      <AdditionalDependencies>nvsdk_ngx_d.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(HaveDlss)'=='true' And '$(Configuration)'=='Debug'">
    <Link>
      <AdditionalDependencies>nvsdk_ngx_d_dbg.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <!-- FSR2 native-D3D11 backend (optiscaler/FidelityFX-FSR2-DX11). Absent => DUST_HAVE_FSR2 undefined =>
       UpscalerFSR2.cpp compiles to stubs. Build libs: external/FSR2-DX11/build BuildLibs (DX11). -->
  <PropertyGroup>
    <HaveFsr2 Condition="Exists('$(ProjectDir)..\external\FSR2-DX11\src\ffx-fsr2-api\bin\ffx_fsr2_api\ffx_fsr2_api_dx11_x64.lib')">true</HaveFsr2>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(HaveFsr2)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>DUST_HAVE_FSR2;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\external\FSR2-DX11\src\ffx-fsr2-api;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\external\FSR2-DX11\src\ffx-fsr2-api\bin\ffx_fsr2_api;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ffx_fsr2_api_x64.lib;ffx_fsr2_api_dx11_x64.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <!-- FSR 3.1 / FSR 4 via the FidelityFX ffx-api (DX12), run on the D3D12 side-device (D3D12Interop).
       Header-only: the loader/provider DLLs are LoadLibrary'd at runtime (no .lib link). Absent =>
       DUST_HAVE_FSR3 undefined => UpscalerFSR3.cpp compiles to stubs. Vendor: sparse-clone the SDK to
       external/FidelityFX-SDK; ship signedbin/amd_fidelityfx_{loader,upscaler}_dx12.dll to the mod dir. -->
  <PropertyGroup>
    <HaveFsr3 Condition="Exists('$(ProjectDir)..\external\FidelityFX-SDK\Kits\FidelityFX\api\include\ffx_api.h')">true</HaveFsr3>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(HaveFsr3)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>DUST_HAVE_FSR3;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\external\FidelityFX-SDK\Kits\FidelityFX\api\include;$(ProjectDir)..\external\FidelityFX-SDK\Kits\FidelityFX\upscalers\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
